# The kit's identity. Every name, storage key and file name in the app comes from these three.
VITE_KIT_ID=freetimekit
VITE_KIT_NAME=FreeTimeKit
VITE_KIT_DESCRIPTION="Günde 10 dakikalık sohbet kartları. Çevrimdışı, hesapsız."

# Local ports. Each kit takes its own pair: on a shared port another kit's service worker opens instead.
DEV_PORT=5177
PREVIEW_PORT=4177
